local Tab = (function()
--[[
    Tab.lua — objeto que devuelve Window:Tab({...}).
    El orden de los widgets es el orden de creación (UIListLayout).
]]

local Widgets = Widgets
local Components = Components
local Utils = Utils

local Theme = Theme
local theme = Theme.palette

local Tab = {}
Tab.__index = Tab

function Tab.new(window, config)
    local self = setmetatable({}, Tab)
    config = config or {}

    self._window = window
    self._order = 0
    self.name = config.name or "Tab"

    local index = #window._tabs + 1

    self.panel = Components.scrollingFrame({
        Name = self.name .. "Panel",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = theme.primary,
        ScrollBarImageTransparency = 0.15,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        ClipsDescendants = true,
        Visible = false,
    }, window._content)
    -- la scrollbar sigue al primary del tema
    Theme.bind(self.panel, "ScrollBarImageColor3", "primary")

    Components.create("UIListLayout", {
        Padding = UDim.new(0, 1),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.panel)

    Components.create("UIPadding", {
        PaddingTop = UDim.new(0, 12),
        PaddingLeft = UDim.new(0, 12),
        PaddingRight = UDim.new(0, 12),
        PaddingBottom = UDim.new(0, 12),
    }, self.panel)

    self.button = Components.button({
        Name = self.name .. "Tab",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme.surface2,
        BackgroundTransparency = 1,
        Text = "               " .. self.name,
        TextColor3 = theme.textMuted,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        CornerRadius = UDim.new(0, 10),
        LayoutOrder = index,
        AutoButtonColor = false,
    }, window._sidebar)

    self.icon = Components.icon(config.icon or "circle", 18, {
        Position = UDim2.new(0, 14, 0.5, -9),
        ImageColor3 = config.color or theme.textMuted,
    }, self.button)

    self.button.MouseEnter:Connect(function()
        if window._activeTab == self then return end
        self.button.BackgroundTransparency = 0.5
        self.button.TextColor3 = theme.text
        self.icon.ImageColor3 = theme.text
    end)
    self.button.MouseLeave:Connect(function()
        if window._activeTab == self then return end
        self.button.BackgroundTransparency = 1
        self.button.TextColor3 = theme.textMuted
        self.icon.ImageColor3 = config.color or theme.textMuted
    end)
    self.button.MouseButton1Click:Connect(function()
        window:_selectTab(self)
    end)

    table.insert(window._tabs, self)
    if #window._tabs == 1 then
        window:_selectTab(self)
    end

    -- Repintado en vivo: tabs activas/inactivas + icono (respeta color custom)
    local customIconColor = config.color ~= nil
    Theme.onChange(function()
        local active = window._activeTab == self
        self.button.BackgroundTransparency = active and 0.2 or 1
        self.button.TextColor3 = active and theme.text or theme.textMuted
        self.button.BackgroundColor3 = theme.surface2
        if not customIconColor then
            self.icon.ImageColor3 = active and theme.text or theme.textMuted
        else
            self.icon.ImageColor3 = config.color
        end
    end, self.button)

    return self
end

-- helper interno: incrementa el orden y pasa config listo al widget
function Tab:_add(builder, config, parentOverride)
    self._order += 1
    config = config or {}
    config.order = config.order or self._order
    local parent = parentOverride or self.panel
    return builder(parent, config)
end

function Tab:Button(config) return self:_add(Widgets.Button, config) end
function Tab:Space(config) return self:_add(Widgets.Space, config) end
function Tab:Toggle(config) return self:_add(Widgets.Toggle, config) end
function Tab:Slider(config) return self:_add(Widgets.Slider, config) end
function Tab:Dropdown(config) return self:_add(Widgets.Dropdown, config) end
function Tab:Keybind(config) return self:_add(Widgets.Keybind, config) end
function Tab:Input(config) return self:_add(Widgets.Input, config) end
function Tab:Card(config) return self:_add(Widgets.Card, config) end

-- HStack/VStack: filas de hasta 3 widgets; `rows = N` reserva N filas
-- (N * 3 elementos) con auto-wrap debajo de la fila anterior.
function Tab:HStack(config)
    return self:_add(function(parent, cfg)
        return Widgets.Stack.new(parent, cfg, self._order)
    end, config)
end
Tab.VStack = Tab.HStack

function Tab:Section(config)
    if type(config) == "string" then config = { title = config } end
    config = config or {}
    self._order += 1
    config.order = config.order or self._order

    local section = Widgets.Section(self.panel, config)

    section.Button = function(_, sectionConfig)
        return self:_add(Widgets.Button, sectionConfig, section.content)
    end
    section.Space = function(_, sectionConfig)
        return self:_add(Widgets.Space, sectionConfig, section.content)
    end
    section.Toggle = function(_, sectionConfig)
        return self:_add(Widgets.Toggle, sectionConfig, section.content)
    end
    section.Slider = function(_, sectionConfig)
        return self:_add(Widgets.Slider, sectionConfig, section.content)
    end
    section.Dropdown = function(_, sectionConfig)
        return self:_add(Widgets.Dropdown, sectionConfig, section.content)
    end
    section.Keybind = function(_, sectionConfig)
        return self:_add(Widgets.Keybind, sectionConfig, section.content)
    end
    section.Input = function(_, sectionConfig)
        return self:_add(Widgets.Input, sectionConfig, section.content)
    end
    section.Card = function(_, sectionConfig)
        return self:_add(Widgets.Card, sectionConfig, section.content)
    end
    section.HStack = function(_, sectionConfig)
        return self:_add(function(parent, cfg)
