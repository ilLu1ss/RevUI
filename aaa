    local hasCustomColor = config.color ~= nil
    local customOnColor = config.color
    local state = config.default == true

    local track = Components.create("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        CornerRadius = UDim.new(1, 0),
        BorderSizePixel = 0,
    }, control)

    local knob = Components.create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        AnchorPoint = Vector2.new(0, 0.5),
        BackgroundColor3 = theme.white,
        CornerRadius = UDim.new(1, 0),
        BorderSizePixel = 0,
    }, track)

    -- color ON: custom del usuario o primary EN VIVO (tema actual)
    local function onColor()
        return hasCustomColor and customOnColor or theme.primary
    end

    local function render(animated)
        local knobX = UDim2.new(state and 1 or 0, state and -21 or 3, 0.5, 0)
        local trackColor = state and onColor() or theme.gray
        if animated then
