        Position = UDim2.new(0, 10, 1, -1),
        Size = UDim2.new(1, -20, 0, 1),
        BackgroundColor3 = theme.gray,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
    }, header)
    Theme.bind(line, "BackgroundColor3", "gray")
    Theme.bind(titleLabel, "TextColor3", "text")

    local content = Components.create("Frame", {
        Name = "Content",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Visible = expanded,
    }, shell)

    Components.create("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, content)

    -- Inset inteligente: el PARENT define el área segura y los widgets
    -- que usan escala 1 se adaptan solos. El inset SOLO aplica cuando hay
    -- borde visible que respetar (box = true o border = true); sin box
    -- y sin borde el contenido va flush y queda alineado con el resto
    -- de widgets de la tab.
    if hasBox or showStroke then
        Components.create("UIPadding", {
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }, content)
    end

    local function setExpanded(value)
        expanded = value
        content.Visible = value
        -- La línea divisoria queda SIEMPRE visible: es el marcador
        -- visual de "esto es una section", tanto abierta como cerrada.
        -- (Antes se hacía line.Visible = value y desaparecía al colapsar.)
        if value then
            content.Size = UDim2.new(1, 0, 0, 0)
        end
    end

    header.MouseButton1Click:Connect(function()
        setExpanded(not expanded)
    end)

    -- Repintado en vivo: icono del header (si no tiene color custom)
    Theme.onChange(function()
        if iconImage and not config._customIconColor then
            iconImage.ImageColor3 = theme.text
        end
    end, section)

    local api = {
        instance = section,
        frame = shell,
        header = header,
        content = content,
        SetExpanded = setExpanded,
    }

    return api
end
end)()

local Slider = (function()
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Theme = Theme
local Components = Components
local WidgetKit = WidgetKit

local theme = Theme.palette

--[[
    Tab:Slider({
        title = "FOV",  min = 30, max = 200, default = 90,
        step = 1,       suffix = "°",
        callback = function(value) end,
    })
    Métodos: slider:Set(number), slider:Get()

    El callback NO se dispara en cada frame del drag: sólo una vez
    al soltar (o al hacer click). Durante el arrastre sólo se
    actualiza el visual (fill, knob, label).
]]

return function(parent, config)
    config = config or {}
    local desc = config.description or config.desc or ""

    local compact = config.compact == true

    local row, title, _ = WidgetKit.row(parent, {
        title = config.title,
        description = desc ~= "" and desc or nil,
        color = config.color,
        order = config.order,
        border = config.border,
    }, { height = 52, controlWidth = 0, compact = compact })

    if desc ~= "" then
        title.Position = UDim2.new(0, 14, 0, 9)
    else
        title.Position = UDim2.new(0, 14, 0, 12)
    end

    -- valueLabel: 90px en normal; en compacto (celda angosta de un Stack)
    -- se encoge a 55px para que el título conserve espacio. Los valores
    -- ("90", "100°", "1.5x") caben de sobra en 55px.
    local valueW = compact and 55 or 90

    -- el título NUNCA corre por debajo del value label
    title.Size = UDim2.new(1, -(valueW + 34), 0, 15)

    local min = config.min or 0 -- xd
    local max = config.max or 100
    local step = config.step or 1
    local value = math.clamp(config.default or min, min, max)

    local valueLabel = Components.create("TextLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -14, 0, config.description and 9 or 8),
        Size = UDim2.new(0, valueW, 0, 16),
        Font = Enum.Font.GothamBold,
        Text = "",
        TextColor3 = theme.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)
    Theme.bind(valueLabel, "TextColor3", "text")

    local track = Components.create("Frame", {
        Position = UDim2.new(0, 14, 1, -18),
        Size = UDim2.new(1, -28, 0, 5),
        BackgroundColor3 = theme.black,
        CornerRadius = UDim.new(1, 0),
        BorderSizePixel = 0,
    }, row)

    local hasCustomColor = config.color ~= nil
    local fill = Components.create("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = config.color or theme.primary,
        CornerRadius = UDim.new(1, 0),
        BorderSizePixel = 0,
    }, track)

    local knob = Components.create("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = theme.white,
        CornerRadius = UDim.new(1, 0),
        BorderSizePixel = 0,
    }, track)

    local function formatNumber(v)
        if step >= 1 then return tostring(math.floor(v + 0.5)) end
        return string.format("%.1f", v)
    end

    local function render()
        local pct = (value - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knob.Position = UDim2.new(pct, 0, 0.5, 0)
        valueLabel.Text = formatNumber(value) .. (config.suffix or "")
    end

    render()

    -- setFromX sólo actualiza el visual. Devuelve true si el valor
    -- cambió respecto al anterior (para saber si hay que disparar el
    -- callback al soltar).
    local function setFromX(x)
        local pct = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        local raw = min + (max - min) * pct
        local snapped = math.floor(raw / step + 0.5) * step
        snapped = math.clamp(snapped, min, max)
        if snapped ~= value then
            value = snapped
            render()
            return true
        end
        return false
    end

    -- drag con conexiones temporales: nada queda conectado al soltar.
    -- El callback se dispara SÓLO al soltar, y sólo si el valor cambió.
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            local changed = setFromX(input.Position.X)

            local moved = UserInputService.InputChanged:Connect(function(i2)
                if i2.UserInputType == Enum.UserInputType.MouseMovement
                    or i2.UserInputType == Enum.UserInputType.Touch then
                    if setFromX(i2.Position.X) then
                        changed = true
                    end
                end
            end)

            local released
            released = UserInputService.InputEnded:Connect(function(i2)
                if i2.UserInputType == Enum.UserInputType.MouseButton1
                    or i2.UserInputType == Enum.UserInputType.Touch then
                    moved:Disconnect()
                    released:Disconnect()
                    -- un único disparo con el valor final
                    if changed and config.callback then
                        config.callback(value)
                    end
                end
            end)
        end
    end)

    -- Repintado en vivo: fill usa primary vivo si no hay color custom
    Theme.onChange(function()
        if not hasCustomColor then
            fill.BackgroundColor3 = theme.primary
        end
    end, row)

    local widget = { instance = row }
    function widget:Set(v, fire)
        value = math.clamp(v, min, max)
        render()
        if fire ~= false and config.callback then config.callback(value) end
    end
    function widget:Get() return value end
    return widget
end
end)()

