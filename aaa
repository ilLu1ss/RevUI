            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, titleCol)
        Theme.bind(titleLabel, "TextColor3", "text")
    end

    ---------------------------------------------------------------
    -- 4) Separador INVISIBLE (estructura título | botones)
    ---------------------------------------------------------------
    if hasButtons then
        Components.create("Frame", {
            Name = "CardSeparator",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -(gridW + PAD), 0.5, 0),
            Size = UDim2.new(0, sepWidth, 1, 0),
            BackgroundTransparency = 1, -- no visible, solo estructura
            BorderSizePixel = 0,
        }, card)
    end

    ---------------------------------------------------------------
    -- 5) Grid de botones (derecha, centrado verticalmente)
    --    Cada botón: [icono] title  — layout horizontal centrado.
    ---------------------------------------------------------------
