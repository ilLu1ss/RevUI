        local grid = Components.create("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -PAD, 0.5, 0),
            Size = UDim2.new(0, gridW, 0, gridH),
            BackgroundTransparency = 1,
