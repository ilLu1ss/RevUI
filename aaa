local Keybind = (function()
local UserInputService = game:GetService("UserInputService")

local Theme = Theme
local Components = Components
local WidgetKit = WidgetKit

local theme = Theme.palette

--[[
    Tab:Keybind({
        title = "Activar",  default = Enum.KeyCode.E,
        callback = function() end,        -- al presionar la tecla bindeada
        onChanged = function(key) end,    -- al rebindear (opcional)
    })
    Métodos: kb:Set(KeyCode), kb:Get()
    Click en el botón para capturar una nueva tecla. Escape cancela.
]]

return function(parent, config)
    config = config or {}
    local desc = config.description or config.desc or ""

    local row, _, control = WidgetKit.row(parent, {
        title = config.title,
        description = desc ~= "" and desc or nil,
        color = config.color,
        order = config.order,
        border = config.border,
    }, { height = 44, controlWidth = 100, controlHeight = 26, compact = config.compact })

    local key = config.default
    local listening = false

    local btn = Components.button({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.black,
        Text = key and key.Name or "None",
        TextSize = 11,
        Font = Enum.Font.GothamBold,
    }, control)
    -- NOTA: el fondo NO se bindea porque en modo captura es primary;
    -- el repintado en vivo lo maneja el Theme.onChange de abajo.
    Theme.bind(btn, "TextColor3", "text")

    local function resetBtn()
        btn.Text = key and key.Name or "None"
        btn.BackgroundColor3 = theme.black
    end

    local connections = {}

    connections[#connections + 1] = btn.MouseButton1Click:Connect(function()
        listening = true
        btn.Text = "..."
        btn.BackgroundColor3 = theme.primary
    end)

    connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if listening then
            if input.KeyCode == Enum.KeyCode.Escape then
                listening = false
            elseif input.KeyCode ~= Enum.KeyCode.Unknown then
                key = input.KeyCode
                listening = false
                if config.onChanged then config.onChanged(key) end
            end
            resetBtn()
            return
        end
        if not gameProcessed and key and input.KeyCode == key then
            if config.callback then config.callback() end
        end
    end)

    -- auto-limpieza: si el widget se destruye, la conexión global muere con él
    WidgetKit.autoCleanup(row, connections)

    local widget = { instance = row }
    function widget:Set(kc)
        key = kc
        btn.Text = key and key.Name or "None"
    end
    function widget:Get() return key end

    -- Repintado en vivo: el botón de captura vuelve a black del tema
    -- (si está en modo captura se respeta el primary actual)
    Theme.onChange(function()
        if not listening then
            btn.BackgroundColor3 = theme.black
        else
            btn.BackgroundColor3 = theme.primary
        end
    end, row)

    return widget
end

end)()

