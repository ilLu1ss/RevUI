                end)
                button.MouseLeave:Connect(function()
                    button.BackgroundTransparency = 1
                end)
            end

            -- Layout horizontal centrado dentro del botón:
            --   [icon] title    (si hay ambos)
            --   [icon]          (si sólo icon)
            --   title           (si sólo title)
            if hasIcon or hasTitle then
                Components.create("UIListLayout", {
                    FillDirection = Enum.FillDirection.Horizontal,
                    HorizontalAlignment = Enum.HorizontalAlignment.Center,
                    VerticalAlignment = Enum.VerticalAlignment.Center,
                    Padding = UDim.new(0, hasIcon and hasTitle and BTN_ICON_PAD or 0),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, button)
            end

            if hasIcon then
                local iconSize = math.floor(math.min(btnW, btnH) * 0.55)
                Components.imageLabel({
                    Size = UDim2.new(0, iconSize, 0, iconSize),
                    BackgroundTransparency = 1,
                    Image = resolveImage(bIcon, "circle"),
                    ImageColor3 = icnColor,
                    LayoutOrder = 1,
                    ZIndex = 3,
                }, button)
            end

            if hasTitle then
                Components.create("TextLabel", {
                    Size = UDim2.new(0, 0, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    BackgroundTransparency = 1,
                    Text = bTitle,
                    Font = Enum.Font.GothamBold,
