                    ZIndex = 3,
                }, button)
            end

            button.MouseButton1Click:Connect(function()
                if btnCfg.callback then
                    btnCfg.callback()
                end
            end)
        end
    end

    return { instance = card }
end
end)()

local Dropdown = (function()
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = Theme
local Components = Components
local WidgetKit = WidgetKit

local theme = Theme.palette
local HEADER = 44

return function(parent, config)
    config = config or {}
    local desc = config.description or config.desc or ""

    local row, title, control = WidgetKit.row(parent, {
        title = config.title,
        description = desc ~= "" and desc or nil,
        color = config.color,
        order = config.order,
        border = config.border,
    }, { height = HEADER, controlWidth = 140, clips = false, compact = config.compact })

    if desc ~= "" then
        title.Position = UDim2.new(0, 14, 0, 9)
    else
        title.Position = UDim2.new(0, 14, 0, 12)
    end

    row.ClipsDescendants = false
    if control and control.ClipsDescendants ~= nil then
        control.ClipsDescendants = false
    end

    local options = config.options or {}
    local selected = config.default or options[1]
    local open = false
    local hasCustomColor = config.color ~= nil

    -- sube el ZIndex de TODOS los ancestros (hasta el ScreenGui) mientras
    -- la lista está abierta: así queda por encima de cualquier widget
    -- posterior aunque el dropdown viva dentro de un Stack o una Section.
    local savedZ = {}
    local function raiseAncestors(on)
        if on then
            savedZ = {}
            local node = row
            while node and node.Parent and not node:IsA("ScreenGui") do
                savedZ[node] = node.ZIndex
                node.ZIndex = 1000
                node = node.Parent
            end
        else
            for inst, z in pairs(savedZ) do
                pcall(function()
                    if inst.Parent then inst.ZIndex = z end
                end)
            end
            savedZ = {}
        end
    end

    local headerBtn = Components.button({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = theme.black,
        Text = selected or "Seleccionar",
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 1,
    }, control)
    Theme.bind(headerBtn, "BackgroundColor3", "black")
    Theme.bind(headerBtn, "TextColor3", "text")
    Components.create("UIPadding", { PaddingLeft = UDim.new(0, 10) }, headerBtn)

    local chevron = Components.icon("chevron-down", 14, {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        ImageColor3 = theme.textMuted,
        ZIndex = 2,
    }, headerBtn)

    local list = Components.create("Frame", {
        Position = UDim2.new(0, 0, 1, 2),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = theme.surface,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 10,
    }, control)
    Theme.bind(list, "BackgroundColor3", "surface")

    local listStroke = Components.create("UIStroke", { Color = theme.surface2, Thickness = 1 }, list)
    Theme.bind(listStroke, "Color", "surface2")

    local scrollingList = Components.create("ScrollingFrame", {
        Position = UDim2.new(0, 4, 0, 4),
        Size = UDim2.new(1, -8, 1, -8),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 2,
        ZIndex = 11,
    }, list)


    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4) 
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.FillDirection = Enum.FillDirection.Vertical
    layout.Parent = scrollingList

    local optionButtons = {}
    local outsideConn = nil

    -- ¿El click cayó dentro del rectángulo absoluto de este GuiObject?
    local function pointInGui(gui, x, y)
        if not gui or not gui.Visible then return false end
        local pos  = gui.AbsolutePosition
        local size = gui.AbsoluteSize
        return x >= pos.X and x <= pos.X + size.X
            and y >= pos.Y and y <= pos.Y + size.Y
    end

    local function disconnectOutside()
        if outsideConn then
            outsideConn:Disconnect()
            outsideConn = nil
        end
    end

    local setOpen -- forward declaration

    local function connectOutside()
        disconnectOutside()
        outsideConn = UserInputService.InputBegan:Connect(function(input, _processed)
            -- NO chequeamos _processed: queremos cerrar aunque otra UI consuma el click
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then
                return
            end

            local x, y = input.Position.X, input.Position.Y

            -- Si el click fue dentro del header, dejamos que el MouseButton1Click haga el toggle
            if pointInGui(headerBtn, x, y) then return end

            -- Si el click fue dentro de la lista, no cerramos
            if pointInGui(list, x, y) then return end

            -- Cualquier otro lugar -> cerrar
            setOpen(false)
        end)
    end

    setOpen = function(state)
        open = state
        if state then
            list.Visible = true
            raiseAncestors(true)
            connectOutside()
        else
            disconnectOutside()
        end

        local targetH = math.min(#options * 32 + 8, 160)

        TweenService:Create(list, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 0, state and targetH or 0),
        }):Play()

        TweenService:Create(chevron, TweenInfo.new(0.2), { Rotation = state and 180 or 0 }):Play()

        if not state then
            task.delay(0.2, function()
                if not open then
                    list.Visible = false
                    raiseAncestors(false)
                end
            end)
        end
    end

    -- pinta las opciones según selección, con paleta VIVA
    local function paintOptions()
        for j, b in ipairs(optionButtons) do
            b.BackgroundColor3 = options[j] == selected and theme.primary or theme.surface2
            b.TextColor3 = theme.text
        end
    end

    local function buildOptions()
        for _, b in ipairs(optionButtons) do b:Destroy() end
        table.clear(optionButtons)
        for i, option in ipairs(options) do
            local optBtn = Components.button({
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = option == selected and theme.primary or theme.surface2,
                Text = tostring(option),
                TextColor3 = theme.text,
                TextSize = 12,
                Font = Enum.Font.Gotham,
                LayoutOrder = i,
                ZIndex = 12,
            }, scrollingList)

            optBtn.MouseButton1Click:Connect(function()
                selected = option
                headerBtn.Text = tostring(option)
                paintOptions()
                setOpen(false)
                if config.callback then config.callback(option) end
            end)
            table.insert(optionButtons, optBtn)
        end
    end

    buildOptions()

    headerBtn.MouseButton1Click:Connect(function()
        setOpen(not open)
    end)

    local widget = { instance = row }
    function widget:Set(option, fire)
        if table.find(options, option) then
            selected = option
            headerBtn.Text = tostring(option)
            if fire ~= false and config.callback then config.callback(option) end
        end
    end

    function widget:Get() return selected end

    function widget:Refresh(newOptions)
        options = newOptions or {}
        if not table.find(options, selected) then
            selected = options[1]
            headerBtn.Text = tostring(selected or "Seleccionar")
        end
        buildOptions()
        if open then setOpen(true) end
    end

    row.Destroying:Connect(function()
        disconnectOutside()
        raiseAncestors(false)
    end)

    -- Repintado en vivo: lista abierta, header, chevron y opciones
    Theme.onChange(function()
        chevron.ImageColor3 = theme.textMuted
        paintOptions()
    end, row)

    return widget --- real
end

end)()

local Input = (function()
--[[
