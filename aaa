                BackgroundColor3 = trackColor,
            }):Play()
        else
            knob.Position = knobX
            track.BackgroundColor3 = trackColor
        end
    end

    render(false)

    -- Repintado en vivo: track según estado, knob siempre blanco
    Theme.onChange(function()
        track.BackgroundColor3 = state and onColor() or theme.gray
        knob.BackgroundColor3 = theme.white
