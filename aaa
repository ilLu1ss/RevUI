        BorderSizePixel = 0,
        AutoButtonColor = false,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

function Components.scrollingFrame(props, parent)
    return Components.create("ScrollingFrame", merge({
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = theme.primary,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, props), parent)
end

function Components.icon(name, size, props, parent)
    return Components.imageLabel(merge({
        Size = UDim2.new(0, size or 20, 0, size or 20),
        BackgroundTransparency = 1,
        Image = Utils.getIcon(name),
        ImageColor3 = theme.text,
    }, props), parent)
end

return Components







