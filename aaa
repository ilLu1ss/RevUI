    ---------------------------------------------------------------
    -- Toggle key — listener único persistente
    --
    -- Antes se reconectaba en cada SetToggleKey, y eso producía
    -- estados inconsistentes (a veces no respondía ni la tecla
    -- nueva ni la vieja). Ahora hay UNA sola conexión que vive
    -- toda la vida de la ventana y consulta window._toggleKey
    -- en tiempo de input. SetToggleKey sólo escribe la variable.
    ---------------------------------------------------------------
    window._toggleKey  = nil
    window._toggleConn = nil

    local function normalizeKey(k)
        if k == nil then return nil end

        -- Enum.KeyCode directo
        if typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then
            return k
        end

        -- String: "K", "RightShift", etc.
        if type(k) == "string" then
            local ok, enum = pcall(function() return Enum.KeyCode[k] end)
            if ok and enum then return enum end
            -- fallback a mayúsculas
            ok, enum = pcall(function() return Enum.KeyCode[k:upper()] end)
            if ok and enum then return enum end
            return nil
        end

        -- Número: buscar por Value
        if type(k) == "number" then
            for _, item in ipairs(Enum.KeyCode:GetEnumItems()) do
                if item.Value == k then return item end
            end
            return nil
        end

        return nil
    end

    -- Conexión única — no se vuelve a crear nunca
    window._toggleConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not window._toggleKey then return end
        -- Ignorar si el input fue procesado por la UI del juego o si hay un TextBox enfocado
        if gameProcessed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == window._toggleKey then
            window:SetVisible(not mainFrame.Visible)
        end
    end)
    table.insert(window._connections, window._toggleConn)

    function window:SetToggleKey(key)
        if key == nil then
            window._toggleKey = nil
            return
        end

        local normalized = normalizeKey(key)
        if not normalized then
            warn(("[RevUI] SetToggleKey: valor inválido %q (%s). Se mantiene la tecla anterior.")
                :format(tostring(key), typeof(key)))
            return
        end

        window._toggleKey = normalized
    end

    function window:GetToggleKey()
        return window._toggleKey
    end

    -- Toggle inicial
    if toggleKey ~= nil then
        window:SetToggleKey(toggleKey)
    end

    ---------------------------------------------------------------
    -- Destroy
    ---------------------------------------------------------------
    function window:Destroy()
        screenGui:Destroy()
    end
    window.destroy = window.Destroy

    screenGui.Destroying:Connect(function()
        for _, conn in ipairs(window._connections) do
            pcall(function() conn:Disconnect() end)
        end
    end)

    return window
end

return Window
end)()

