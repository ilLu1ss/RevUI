function Dialog.show(gui, config)
    config = config or {}
    local buttons = config.buttons or { { text = "OK" } }

    -- Blocker: atrapa clicks fuera del diálogo sin pintar nada.
    local blocker = Components.create("TextButton", {
        Name = "DialogBlocker",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Active = true,
        ZIndex = 200,
    }, gui)

    local card = Components.create("Frame", {
        Name = "Dialog",
        Size = UDim2.new(0, 280, 0, 150),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.surface,
        BorderSizePixel = 0,
        ZIndex = 201,
        CornerRadius = UDim.new(0, 14),
        Stroke = { Color = Color3.fromRGB(45, 45, 55), Thickness = 1, Transparency = 0.5 },
    }, blocker)
    -- el diálogo sigue al tema mientras esté abierto
    Theme.bind(card, "BackgroundColor3", "surface")

    Components.label({
        Size = UDim2.new(1, -32, 0, 20),
        Position = UDim2.new(0, 16, 0, 18),
        Text = config.title or "",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        ZIndex = 202,
    }, card)

    Components.label({
        Size = UDim2.new(1, -32, 0, 60),
        Position = UDim2.new(0, 16, 0, 44),
        Text = config.message or "",
        TextColor3 = theme.textMuted,
        TextSize = 13,
        TextWrapped = true,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 202,
    }, card)

    local buttonRow = Components.create("Frame", {
        Position = UDim2.new(0, 16, 1, -52),
        Size = UDim2.new(1, -32, 0, 36),
        BackgroundTransparency = 1,
        ZIndex = 202,
    }, card)

    Components.create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 8),
    }, buttonRow)

    local closed = false
    local function close()
        if closed then return end
        closed = true
        local tween = TweenService:Create(card,
            TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
            { Size = UDim2.new(0, 260, 0, 140) })
        tween:Play()
        tween.Completed:Connect(function()
            blocker:Destroy()
        end)
    end

    for _, btnCfg in ipairs(buttons) do
        local style = btnCfg.style or "primary"
        local btn = Components.button({
            Size = UDim2.new(0, 110, 1, 0),
            BackgroundColor3 = style == "danger" and theme.danger
                or style == "primary" and theme.primary
                or theme.surface2,
            Text = btnCfg.text or "OK",
            TextSize = 13,
            ZIndex = 203,
            AutoButtonColor = style ~= "ghost",
        }, buttonRow)
        if style == "ghost" then
            btn.BackgroundTransparency = 0.4
        end
        btn.MouseButton1Click:Connect(function()
            close()
            if btnCfg.callback then task.spawn(btnCfg.callback) end
        end)
    end

    -- Animación de entrada
    TweenService:Create(card,
        TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = UDim2.new(0, 320, 0, 170) }):Play()

    return {
        Close = close,
        instance = card,
    }
end

return Dialog
end)()

local Notifications = (function()
--[[
    Notifications.lua — v2: config por tabla, duración configurable,
    límite de 4 en pantalla, click para descartar.
]]

local TweenService = game:GetService("TweenService")

local Theme = Theme
local Components = Components
local Utils = Utils

local theme = Theme.palette

local Notifications = {}

local notifIcons = {
    success = "check", error = "ban", warning = "triangle-alert",
    info = "info", playing = "clapperboard", saved = "save",
}
local notifTitles = {
    success = "Success", error = "Error", warning = "Warning",
    info = "Info", playing = "Now Playing", saved = "Saved",
}
local notifColors = {
    success = "success", error = "danger", warning = "warning",
    info = "info", playing = "primary", saved = "purple",
}

local notificationHolder = nil
local MAX_VISIBLE = 4

function Notifications.init(screenGui)
    if notificationHolder and notificationHolder.Parent then return end

    notificationHolder = Components.frame({
        Name = "NotificationHolder",
        Size = UDim2.new(0, 320, 1, -40),
        Position = UDim2.new(1, -340, 0.5, -200),
        BackgroundTransparency = 1,
        ZIndex = 100,
    }, screenGui)

    Components.create("UIListLayout", {
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Top,
        Padding = UDim.new(0, 14),
    }, notificationHolder)

    Components.create("UIPadding", {
        PaddingTop = UDim.new(0, 8),
        PaddingRight = UDim.new(0, 8),
    }, notificationHolder)
end

local function dismiss(notif)
    if not notif or not notif.Parent then return end
    local tween = TweenService:Create(notif,
        TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(1, 18, 0, 0),
            BackgroundTransparency = 1,
        })
    tween:Play()
    tween.Completed:Connect(function()
        if notif and notif.Parent then notif:Destroy() end
    end)
end

-- aceptaNotifications.show("msg", "info") (compat) o .show({message=..., type=..., duration=...})
function Notifications.show(messageOrConfig, legacyType)
    local cfg = type(messageOrConfig) == "table" and messageOrConfig
        or { message = messageOrConfig, type = legacyType }

    local notifType = cfg.type or "info"
    local duration = cfg.duration or 3.2

    if not notificationHolder or not notificationHolder.Parent then
        warn("[RevUI] Notifications.init no ha sido llamado")
        return
    end

    -- límite: si ya hay MAX_VISIBLE, expulsa la más vieja
    local count = 0
    local oldest = nil
    for _, child in ipairs(notificationHolder:GetChildren()) do
        if child:IsA("Frame") then
            count += 1
            if oldest == nil or child.LayoutOrder < oldest.LayoutOrder then
                oldest = child
            end
        end
    end
    if count >= MAX_VISIBLE and oldest then
        oldest:Destroy()
    end

    local colorKey = notifColors[notifType] or "surface2"
    local notif = Components.frame({
        Size = UDim2.new(0, 270, 0, 70),
        BackgroundColor3 = theme[colorKey],
        ZIndex = 101,
        CornerRadius = UDim.new(0, 12),
        Stroke = { Color = theme.white, Thickness = 1, Transparency = 0.88 },
    }, notificationHolder)
    notif.LayoutOrder = os.clock()

    -- el fondo sigue al tema si el tipo usa un color de paleta (no custom)
    Theme.bind(notif, "BackgroundColor3", colorKey)

    Components.icon(notifIcons[notifType] or "bell", 24, {
        Position = UDim2.new(0, 14, 0.5, -10),
        ImageColor3 = theme.white,
        ZIndex = 102,
    }, notif)

    Components.label({
        Size = UDim2.new(1, -80, 0, 18),
        Position = UDim2.new(0, 62, 0, 15),
        Text = cfg.title or notifTitles[notifType] or "Notification",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = theme.white,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 102,
    }, notif)

    Components.label({
        Size = UDim2.new(1, -80, 0, 36),
        Position = UDim2.new(0, 62, 0, 38),
        Text = tostring(cfg.message or ""),
        TextSize = 13,
        TextColor3 = theme.white,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 102,
    }, notif)

    -- click en el cuerpo: onclick o descartar
    local clickBtn = Components.create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 103,
    }, notif)
    clickBtn.MouseButton1Click:Connect(function()
        if cfg.onclick then cfg.onclick() end
        dismiss(notif)
    end)

    notif.Position = UDim2.new(1, 18, 0, 0)
    notif.BackgroundTransparency = 0.15

    TweenService:Create(notif,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 0,
        }):Play()

    task.delay(duration, function()
        if notif and notif.Parent then dismiss(notif) end
    end)

    return notif
end

return Notifications
end)()

local WidgetKit = (function()
--[[
    WidgetKit.lua — fila estándar de widget: título (+descripción) a la
    izquierda, zona de control a la derecha. Nada de posiciones manuales
    fuera de esta plantilla.
]]

local Theme = Theme
local Components = Components

local theme = Theme.palette

local WidgetKit = {}

function WidgetKit.resolveTextAlign(align)
    if align == "center" then
        return Enum.TextXAlignment.Center
    elseif align == "right" then
        return Enum.TextXAlignment.Right
    end
    return Enum.TextXAlignment.Left
end

-- options: height, controlWidth, controlHeight, clips, compact
-- config: title, description, color, order, border
--
-- compact = true → layout vertical: título (+descripción) arriba y el
-- control DEBAJO a ancho completo. Pensado para espacios angostos
-- (celdas de HStack), donde un control fijo de 140px no cabe al lado
-- del título. En modo normal el texto NUNCA corre por debajo del
-- control: se reserva su ancho a la derecha.
function WidgetKit.row(parent, config, options)
    options = options or {}
    config = config or {}

    local descriptionText = config.description or config.desc or ""
    local compact = options.compact == true
    local controlWidth = options.controlWidth or 0
    local controlHeight = options.controlHeight or 24

    local height = (descriptionText ~= "" and (options.height or 44) + 12) or (options.height or 44)
    -- en compacto el control vive debajo del texto: la fila crece
    if compact and controlWidth > 0 then
        height += controlHeight + 10
    end

    local row = Components.create("Frame", {
        Name = config.title or "Widget",
        Size = UDim2.new(1, -2, 0, height),
        BackgroundColor3 = config.color or theme.surface2,
        BorderSizePixel = 0,
        CornerRadius = UDim.new(0, 8),
        LayoutOrder = config.order or 0,
        ClipsDescendants = options.clips == true,
    }, parent)

    if not config.color then
        Theme.bind(row, "BackgroundColor3", "surface2")
    end

    -- borde opcional: config.border = true (default false)
    if config.border == true then
        local rowStroke = Components.create("UIStroke", {
            Color = theme.border,
            Thickness = 1,
            Transparency = 0.4,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, row)
        Theme.bind(rowStroke, "Color", "border")
    end

    -- reserva de ancho del texto: en normal se resta el control a la
    -- derecha (el título trunca antes de tocarlo); en compacto el
    -- control está abajo, así que el texto usa todo el ancho.
    local textReserve = (not compact and controlWidth > 0) and (controlWidth + 22) or 26

    local title = Components.create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, descriptionText ~= "" and 8 or 9),
        Size = UDim2.new(1, -textReserve, 0, 15),
        Font = Enum.Font.GothamSemibold,
        Text = config.title or "",
        TextColor3 = theme.text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)
    -- título y descripción siguen al tema EN VIVO en todos los widgets
    Theme.bind(title, "TextColor3", "text")

    if descriptionText ~= "" then
        local descLabel = Components.create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 22),
            Size = UDim2.new(1, -textReserve, 0, 12),
            Font = Enum.Font.Gotham,
            Text = descriptionText,
            TextColor3 = theme.textMuted,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
        Theme.bind(descLabel, "TextColor3", "textMuted")
    end

    local control = nil
    if controlWidth > 0 then
        if compact then
            -- compacto: control abajo, ancho completo del row
            control = Components.create("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 1, -(controlHeight + 10)),
                Size = UDim2.new(1, -20, 0, controlHeight),
            }, row)
        else
            -- normal: control a la derecha, ancho fijo
            control = Components.create("Frame", {
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -10, 0.5, 0),
                Size = UDim2.new(0, controlWidth, 0, controlHeight),
            }, row)
        end
    end

    return row, title, control
end

-- overlay clicable invisible (para que TODA la fila sea clicable)
function WidgetKit.overlay(row)
    return Components.create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
    }, row)
end

-- limpia conexiones cuando la instancia muere (fase 0: cero zombis)
function WidgetKit.autoCleanup(instance, connections)
    instance.Destroying:Connect(function()
        for _, conn in ipairs(connections) do
            pcall(function() conn:Disconnect() end)
        end
    end)
end

--[[
    hover theme-aware. `baseColorOrGetter` puede ser:
      - un Color3 fijo (color custom pasado por el usuario) → siempre ese.
      - nil → lee theme.surface2 EN VIVO en cada hover, así un cambio de
        tema nunca deja el hover restaurando un color viejo.
]]
function WidgetKit.hover(row, baseColorOrGetter)
    local function resolve()
        if type(baseColorOrGetter) == "function" then
            return baseColorOrGetter()
        end
        return baseColorOrGetter or theme.surface2
    end

    row.MouseEnter:Connect(function()
        row.BackgroundColor3 = resolve():Lerp(theme.white, 0.06)
    end)
    row.MouseLeave:Connect(function()
        row.BackgroundColor3 = resolve()
    end)
end

return WidgetKit
end)()

local Button = (function()
local Theme = Theme
local WidgetKit = WidgetKit
local Components = Components 

local theme = Theme.palette

return function(parent, config)
    config = config or {}

    local desc = config.description or config.desc or ""
    local hasDesc = desc ~= ""

    -- El botón NUNCA cambia de tamaño: pasamos el config SIN description a
    -- WidgetKit.row para que la fila conserve su altura base (40px).
    local rowConfig = {}
    for k, v in pairs(config) do
        if k ~= "description" and k ~= "desc" then
            rowConfig[k] = v
        end
    end

    local row, title = WidgetKit.row(parent, rowConfig, { height = 40 })
    local baseColor = config.color or theme.surface2
    local align = config.align or config.textAlign or "center"
    local resolvedAlign = WidgetKit.resolveTextAlign(align)
    local textColor = config.textColor or theme.text
    local iconName = config.icon
    local iconSize = config.iconSize or 14
    local iconColor = iconName and (config.iconColor or textColor) or nil

    -- insets horizontales del texto: con ícono el contenido se corre a su derecha
    local hasIcon = iconName ~= nil and iconName ~= ""
    local textX = hasIcon and 30 or 12
    local textW = hasIcon and -42 or -24

    row.BackgroundColor3 = baseColor
    title.TextColor3 = textColor
    title.TextXAlignment = resolvedAlign
    title.TextYAlignment = Enum.TextYAlignment.Center

    -- WidgetKit.row ya bindeó fila, título y descripción al tema EN VIVO.
    -- Si el usuario pasa textColor custom, prevalece sobre el bind.
    local customColor = config.color ~= nil
    local customText = config.textColor ~= nil
    if customText then
        title.TextColor3 = textColor
    end

    if hasIcon then
        Components.icon(iconName, iconSize, {
            Position = UDim2.new(0, 14, 0.5, -(iconSize / 2)),
            ImageColor3 = iconColor,
        }, row)
    end

    if hasDesc then
        -- Con description: el title sube un poco y la description ocupa la
        -- línea de abajo con la MISMA alineación que el title.
        -- El tamaño del botón sigue siendo exactamente el mismo (40px).
        title.Position = UDim2.new(0, textX, 0, 7)
        title.Size = UDim2.new(1, textW, 0, 14)

        local descLabel = Components.create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, textX, 0, 22),
            Size = UDim2.new(1, textW, 0, 11),
            Font = Enum.Font.Gotham,
            Text = desc,
            TextColor3 = theme.textMuted,
            TextSize = 10,
            TextXAlignment = resolvedAlign,
            TextYAlignment = Enum.TextYAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, row)
        Theme.bind(descLabel, "TextColor3", "textMuted")
    else
        -- Sin description: layout de siempre (texto centrado verticalmente)
        title.Position = UDim2.new(0, hasIcon and 30 or 0, 0, 0)
        title.Size = UDim2.new(1, textW, 1, 0)
    end

    local btn = WidgetKit.overlay(row)
    -- hover: color custom → fijo; si no → getter vivo de la paleta
    if customColor then
        WidgetKit.hover(row, baseColor)
    else
        WidgetKit.hover(row, function() return theme.surface2 end)
    end

    btn.MouseButton1Click:Connect(function()
        if config.callback then config.callback() end
    end)

    local widget = { instance = row }
    function widget:SetText(text)
        title.Text = text
    end
    return widget
end
end)()

local Card = (function()
--[[
    Card.lua — tarjeta horizontal estilo "resultado de emote":

        ┌─────────────────────────────┐
        │ [thumb]  Title     ╎ [□][□] │
        │ [thumb]  subtitle  ╎ [□][□] │
        └─────────────────────────────┘

    Estructura (basada en las cards de búsqueda de emotes):
      1. Holder (la tarjeta, altura fija según `size`)
      2. Thumbnail a la IZQUIERDA, centrado verticalmente
      3. Título + subtítulo/descripción al centro
      4. Separador INVISIBLE (solo estructura)
      5. Grid de botones a la derecha (2 columnas, MÁXIMO 4)

    Diseñada para ser angosta: su ancho lo define el contenedor
    (en un HStack con perRow = 2 o 3 queda compacta; suelta ocupa
    el ancho de la tab).

    tab:Card({
        title = "Title",
        subtitle = "subtitle",       -- o description
        icon = "rbxassetid://..." | "lucide-name",
        size = 3,                    -- 1..5, default 3 (absoluto)
        buttons = {                  -- MÁXIMO 4
            { icon = "play", title = "Run", callback = fn,
              color = Color3, textColor = Color3, iconColor = Color3 },
        },
    })

    Botones: únicos elementos con color configurable.
      - El botón muestra ICONO + TITLE al mismo tiempo, en layout
        horizontal centrado: [icon] title.
      - Si sólo pasas `title`, se ve sólo el texto (centrado).
      - Si sólo pasas `icon`, se ve sólo el icono (centrado).
      - Si no pasas `color`, el fondo es transparente y el hover
        muestra `surface2` del tema (estilo emote).

    NOTAS:
      - `btnW` es el ANCHO del botón (rectangular, no cuadrado).
        `btnH` es el ALTO. Antes ambos eran el mismo `btnSize`, así
        que los botones salían cuadrados y enormes.
      - `button` (dentro del loop) es la Instance; no debe confundirse
        con `btnW`/`btnH` (números).
]]

local Theme = Theme
local Components = Components
local WidgetKit = WidgetKit
local Utils = Utils

local theme = Theme.palette

-- tamaño absoluto 1..5 → { altura card, lado del thumbnail }
local CARD_BY_SIZE = {
    { 64, 44 },
    { 72, 52 },
    { 80, 60 }, -- default: clavado a la card de emotes (80 alto, thumb 60)
    { 88, 66 },
    { 96, 72 },
}
local MAX_BUTTONS = 4
local PAD = 10

-- Altura de los botones (el ancho sale de la fórmula original)
local BTN_H_RATIO = 0.32   -- fracción de la altura de la card
local BTN_H_MIN   = 18     -- por si la card es muy bajita
local BTN_GAP     = 4      -- padding entre celdas del grid
local BTN_ICON_PAD = 4     -- espacio entre icono y título dentro del botón

-- resuelve "rbxassetid://..." | "rbxasset://..." directo, o nombre Lucide
local function resolveImage(value, fallbackName)
    if type(value) == "number" then
        return "rbxassetid://" .. tostring(value)
    end
    if type(value) == "string" then
        if value:sub(1, 11) == "rbxassetid://" or value:sub(1, 10) == "rbxasset://" then
            return value
        end
        local id = Utils.getIcon(value)
        if id ~= "" then
            return id
        end
    end
    return Utils.getIcon(fallbackName or "image")
end

return function(parent, config)
    config = config or {}

    local sizeN = math.clamp(math.floor(tonumber(config.size) or 3), 1, 5)
    local cardH = CARD_BY_SIZE[sizeN][1]
    local thumb = CARD_BY_SIZE[sizeN][2]
    local title = config.title or config.Title or "Title"
    local subtitle = config.subtitle or config.Subtitle or config.description or config.desc or ""
    local buttons = config.buttons or {}

    if #buttons > MAX_BUTTONS then
        error("[RevUI] Card: máximo 4 botones (recibidos " .. #buttons .. ").", 2)
    end

    ---------------------------------------------------------------
    -- 1) Holder (altura fija, como la card de emotes)
    ---------------------------------------------------------------
    local card = Components.frame({
        Name = "Card:" .. title,
        Size = UDim2.new(1, -2, 0, cardH),
        BackgroundColor3 = theme.surface2,
        CornerRadius = UDim.new(0, 10),
        LayoutOrder = config.order or 0,
        ClipsDescendants = true,
    }, parent)
    Theme.bind(card, "BackgroundColor3", "surface2")

    -- borde opcional: config.border = true (default false)
    if config.border == true then
        local cardStroke = Components.create("UIStroke", {
            Color = theme.border,
            Thickness = 1,
            Transparency = 0.4,
            ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        }, card)
        Theme.bind(cardStroke, "Color", "border")
    end

    ---------------------------------------------------------------
    -- 2) Thumbnail a la izquierda, centrado verticalmente
    ---------------------------------------------------------------
    local hasImage = config.icon ~= nil and config.icon ~= ""
    local thumbBg = Components.frame({
        Position = UDim2.new(0, PAD, 0.5, -thumb / 2),
        Size = UDim2.new(0, thumb, 0, thumb),
        BackgroundColor3 = theme.surface,
        CornerRadius = UDim.new(0, 8),
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, card)
    Theme.bind(thumbBg, "BackgroundColor3", "surface")

    if hasImage then
        Components.imageLabel({
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Image = resolveImage(config.icon, "image"),
            ImageColor3 = theme.white,
            ScaleType = Enum.ScaleType.Fit,
        }, thumbBg)
    else
        Components.icon("image", math.floor(thumb * 0.4), {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            ImageColor3 = theme.textMuted,
        }, thumbBg)
    end

    ---------------------------------------------------------------
    -- Botones: geometría del grid (2 columnas, máx 2 filas)
    --   btnW: mismo ancho que antes (rectangular, no cuadrado)
    --   btnH: mucho más bajo
    ---------------------------------------------------------------
    local hasButtons = #buttons > 0
    local gridRows = hasButtons and math.ceil(math.min(#buttons, MAX_BUTTONS) / 2) or 1

    local btnW = math.max(20, math.floor((cardH - 16 - (gridRows - 1) * 4) / gridRows))
    local btnH = math.max(BTN_H_MIN, math.floor(cardH * BTN_H_RATIO))

    local gridW = 2 * btnW + BTN_GAP
    local gridH = gridRows * btnH + (gridRows - 1) * BTN_GAP

    ---------------------------------------------------------------
    -- 3) Título + subtítulo/descripción (centro)
    ---------------------------------------------------------------
    local sepWidth = hasButtons and 8 or 0
    local titleCol = Components.create("Frame", {
        Position = UDim2.new(0, PAD + thumb + 10, 0, 0),
