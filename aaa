    function widget:Set(value, fire)
        state = value == true
        render(true)
        if fire ~= false and config.callback then config.callback(state) end
    end
    function widget:Get() return state end
    return widget
end
end)()

local Stack = (function()
--[[
    Stack.lua — contenedores de fila (HStack/VStack) para agrupar
    widgets horizontalmente.

    local row = tab:HStack({ p = 4 })   -- padding opcional en px
    row:Button({ title = "A" })
    row:Button({ title = "B" })

    local row2 = tab:HStack({ p = 4, perRow = 2 }) -- 2 elementos por fila
    row2:Button({ title = "A" })                    -- cada uno 1/2 del ancho
    row2:Button({ title = "B" })

    Reglas:
    - `perRow = N` define cuántos elementos por fila (1..3, default 3).
      Con 2, cada widget ocupa 1/2 del ancho (no quedan pequeños);
      con 1, ancho completo.
    - `rows = N` reserva N filas: puedes agregar hasta N * perRow
      elementos; al llenar una fila, el siguiente baja automáticamente.
    - Modo compacto automático: los widgets con control ancho fijo
      (Dropdown, Keybind, Input) ponen el control debajo del título
      para caber en la celda. `compact = false` por widget lo desactiva.
    - NO se pueden anidar stacks (row dentro de row lanza error).
    - El stack se parenta a la tab (o sección) donde fue creado.
    - VStack es alias de HStack: ambos llenan filas de izquierda a
      derecha y envuelven hacia abajo (el nombre solo expresa intención).
]]

local Components = Components

-- NOTA: se requieren los widgets directamente (NO vía init.lua) para
-- evitar la dependencia circular init → Stack → init.
local WidgetButton = Button
local WidgetToggle = Toggle
local WidgetSlider = Slider
local WidgetDropdown = Dropdown
local WidgetKeybind = Keybind
local WidgetInput = Input
local WidgetSpace = Space
local WidgetCard = Card

local MAX_PER_ROW = 3

local Stack = {}
Stack.__index = Stack

--[[
    Stack.new(parentContainer, config, orderBase)
      parentContainer: frame destino (tab panel o section content)
      config: { p = padding px, rows = filas a reservar, order = LayoutOrder }
      orderBase: _order actual de la tab/section (para LayoutOrder del root)
]]
function Stack.new(parentContainer, config, orderBase)
    config = config or {}

    local padding = tonumber(config.p or config.padding or config.gap) or 6
    local reservedRows = math.max(1, tonumber(config.rows or 1) or 1)
    -- elementos por fila: 1..3 (default 3). Con 2, cada widget ocupa
    -- 1/2 del ancho; con 1, ancho completo. Máximo SIEMPRE 3.
    local perRow = math.clamp(math.floor(tonumber(
        config.perRow or config.cols or config.columns or config.per_row
    ) or MAX_PER_ROW), 1, MAX_PER_ROW)

    local root = Components.create("Frame", {
        Name = "Stack",
        Size = UDim2.new(1, -2, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = config.order or orderBase or 0,
    }, parentContainer)

    Components.create("UIListLayout", {
        Padding = UDim.new(0, padding),
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
    }, root)

    local stack = setmetatable({
        _root = root,
        _padding = padding,
        _perRow = perRow,
        _rowsUsed = 0,
        _reservedRows = reservedRows,
        _inRow = 0,
        _currentRow = nil,
        _isStack = true,
    }, Stack)

    function stack:_newRow()
        self._rowsUsed += 1
        if self._rowsUsed > self._reservedRows then
            error("[RevUI] Stack: excediste las filas reservadas (rows = "
                .. tostring(self._reservedRows) .. "). Sube `rows` o crea otro stack.", 3)
        end

        local row = Components.create("Frame", {
            Name = "StackRow" .. self._rowsUsed,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            LayoutOrder = self._rowsUsed,
        }, self._root)

        Components.create("UIListLayout", {
            Padding = UDim.new(0, self._padding),
            SortOrder = Enum.SortOrder.LayoutOrder,
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Top,
        }, row)

        self._currentRow = row
        self._inRow = 0
        return row
    end

    -- interno: envuelve cada widget en una celda de 1/perRow de ancho
    function stack:_add(builder, widgetConfig)
        if self._inRow >= self._perRow then
            self:_newRow()
        end
        if not self._currentRow then
            self:_newRow()
        end

        self._inRow += 1

        -- ancho exacto para llenar la fila: escala 1/perRow repartiendo
        -- los gaps ((perRow-1) * padding) entre las celdas
        local cell = Components.create("Frame", {
            Name = "StackCell",
            Size = UDim2.new(
                1 / self._perRow,
                -((self._perRow - 1) * self._padding) / self._perRow,
                0, 0
            ),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            LayoutOrder = self._inRow,
        }, self._currentRow)

        widgetConfig = widgetConfig or {}
        -- modo compacto automático: los widgets con control ancho fijo
        -- (Dropdown, Keybind, Input) ponen el control DEBAJO del título
        -- para caber en la celda. `compact = false` por widget lo desactiva.
        if widgetConfig.compact == nil then
            widgetConfig.compact = true
        end
        return builder(cell, widgetConfig)
    end

    ---------------------------------------------------------------
    -- API pública: widgets en fila
    ---------------------------------------------------------------
    function stack:Button(cfg) return self:_add(WidgetButton, cfg) end
    function stack:Toggle(cfg) return self:_add(WidgetToggle, cfg) end
    function stack:Slider(cfg) return self:_add(WidgetSlider, cfg) end
    function stack:Dropdown(cfg) return self:_add(WidgetDropdown, cfg) end
    function stack:Keybind(cfg) return self:_add(WidgetKeybind, cfg) end
    function stack:Input(cfg) return self:_add(WidgetInput, cfg) end
    function stack:Card(cfg) return self:_add(WidgetCard, cfg) end

    function stack:Space(cfg)
        cfg = cfg or {}
        cfg.p = cfg.p or cfg.padding or cfg.size or cfg.height or cfg.value or 8
        return self:_add(WidgetSpace, cfg)
    end

    -- anidamiento prohibido
    function stack:HStack(_)
        error("[RevUI] No se puede crear un Stack dentro de otro Stack.", 2)
    end
    stack.VStack = stack.HStack

    -- Section dentro de stack: prohibido también (mantiene simple)
    function stack:Section(_)
        error("[RevUI] No se puede crear una Section dentro de un Stack.", 2)
    end

    return stack
end

return Stack
end)()

