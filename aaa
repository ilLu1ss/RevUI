local SpecialKeys = (function()

--[[
    SpecialKeys.lua — props mágicas del constructor declarativo.

    Importante: Components.create intenta asignar la propiedad real ANTES
    de caer aquí. Así que estos atajos solo se ejecutan cuando la instancia
    no tiene esa propiedad (por ejemplo CornerRadius sobre un TextButton,
    que en Roblox se implementa como un UICorner hijo).

    Corolario: Padding sobre un UIListLayout/UIGridLayout NO llega aquí,
    porque esos objetos sí tienen la propiedad real Padding y se asigna
    directo. Este atajo solo se usa para meter un UIPadding en Frames,
    Buttons, etc.
]]

local specialKeys = {
    CornerRadius = function(obj, value)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = value
        corner.Parent = obj
    end,

    Stroke = function(obj, value)
        local stroke = Instance.new("UIStroke")
        if type(value) == "table" then
            stroke.Color = value.Color or Color3.new(0, 0, 0)
            stroke.Thickness = value.Thickness or 1
            stroke.Transparency = value.Transparency or 0
            stroke.ApplyStrokeMode = value.ApplyStrokeMode or Enum.ApplyStrokeMode.Border
        else
            stroke.Thickness = value
        end
        stroke.Parent = obj
    end,

    Padding = function(obj, value)
        local pad = Instance.new("UIPadding")

        -- Normaliza: acepta número o UDim indistintamente.
        local function norm(v)
            if typeof(v) == "UDim" then return v end
            if type(v) == "number" then return UDim.new(0, v) end
            return UDim.new(0, 0)
        end

        if type(value) == "table"
            and (value.Top or value.Bottom or value.Left or value.Right) then
            pad.PaddingTop    = norm(value.Top)
            pad.PaddingBottom = norm(value.Bottom)
            pad.PaddingLeft   = norm(value.Left)
            pad.PaddingRight  = norm(value.Right)
        else
            local v = norm(value)
            pad.PaddingTop    = v
            pad.PaddingBottom = v
            pad.PaddingLeft   = v
            pad.PaddingRight  = v
        end

        pad.Parent = obj
    end,

    ListLayout = function(obj, value)
        local layout = Instance.new("UIListLayout")
        layout.Padding = value.Padding or UDim.new(0, 0)
        layout.FillDirection = value.FillDirection or Enum.FillDirection.Vertical
        layout.HorizontalAlignment = value.HorizontalAlignment or Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = value.VerticalAlignment or Enum.VerticalAlignment.Top
        layout.SortOrder = value.SortOrder or Enum.SortOrder.LayoutOrder
        layout.Parent = obj
        return layout
    end,

    GridLayout = function(obj, value)
        local layout = Instance.new("UIGridLayout")
        layout.CellSize = value.CellSize or UDim2.new(0, 100, 0, 100)
        layout.CellPadding = value.CellPadding or UDim.new(0, 0)
        layout.FillDirection = value.FillDirection or Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = value.HorizontalAlignment or Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = value.VerticalAlignment or Enum.VerticalAlignment.Top
        layout.SortOrder = value.SortOrder or Enum.SortOrder.LayoutOrder
        layout.Parent = obj
        return layout
    end,

    AspectRatio = function(obj, value)
        local c = Instance.new("UIAspectRatioConstraint")
        if type(value) == "table" then
            c.AspectRatio = value.AspectRatio or 1
            c.AspectType = value.AspectType or Enum.AspectType.FitWithinMaxSize
            c.DominantAxis = value.DominantAxis or Enum.DominantAxis.Width
        else
            c.AspectRatio = value
        end
        c.Parent = obj
    end,

    SizeConstraint = function(obj, value)
        local c = Instance.new("UISizeConstraint")
        c.MinSize = value.MinSize or Vector2.new(0, 0)
        c.MaxSize = value.MaxSize or Vector2.new(math.huge, math.huge)
        c.Parent = obj
    end,

    TextConstraint = function(obj, value)
        local c = Instance.new("UITextSizeConstraint")
        c.MinTextSize = value.MinTextSize or 1
        c.MaxTextSize = value.MaxTextSize or 100
        c.Parent = obj
    end,

    Gradient = function(obj, value)
        local g = Instance.new("UIGradient")
        g.Color = value.Color or ColorSequence.new(Color3.new(1, 1, 1))
        g.Rotation = value.Rotation or 0
        g.Offset = value.Offset or Vector2.new(0, 0)
        if value.Transparency then g.Transparency = value.Transparency end
        g.Parent = obj
    end,

    Events = function(obj, value)
        for eventName, callback in pairs(value) do
            local event = obj[eventName]
            if event and typeof(event) == "RBXScriptSignal" then
                event:Connect(callback)
            end
        end
    end,

    Children = function(obj, value)
        for _, child in ipairs(value) do
            if typeof(child) == "Instance" then
                child.Parent = obj
            end
        end
    end,
}

return specialKeys

end)()

