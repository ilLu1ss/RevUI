local Utils = (function()
--[[
    Utils.lua — utilidades: parent seguro, íconos, merge de props.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Icons = Icons

local Utils = {}

function Utils.randomString(length)
    length = length or math.random(12, 24)
    local chars = {}
    for i = 1, length do
        chars[i] = string.char(math.random(32, 126))
    end
    return table.concat(chars)
end

function Utils.getSecureParent()
    -- Studio: CoreGui no es accesible desde LocalScript → PlayerGui
    if RunService:IsStudio() then
        local player = Players.LocalPlayer
        return player:FindFirstChildOfClass("PlayerGui")
            or player:WaitForChild("PlayerGui")
    end

    -- Ejecutor: rutas normales de ocultamiento
    local CoreGui = game:GetService("CoreGui")

    if get_hidden_gui then
        return get_hidden_gui()
    elseif gethui then
        return gethui()
    end

    if syn and syn.protect_gui then
        local protected = Instance.new("ScreenGui")
        protected.Name = Utils.randomString()
        syn.protect_gui(protected)
        protected.Parent = CoreGui
        return protected
    end

    return CoreGui
end

function Utils.getIcon(name)
    return Icons[name] or ""
end

function Utils.merge(defaults, props)
    props = props or {}
    for k, v in pairs(props) do
        if k == "BgColor" then
            defaults["BackgroundColor3"] = v
        else
            defaults[k] = v
        end
    end
    return defaults
end

return Utils
end)()

local Components = (function()
--[[
    Components.lua — constructor declarativo y componentes con defaults.
    Los colores se resuelven AL CREAR desde Theme.palette (referencia
    viva), así los elementos nuevos siempre respetan el tema actual.

    Orden de resolución de props en Components.create:
      1. Propiedad real de la instancia  → se asigna directo.
      2. specialKeys[key]                → se aplica el atajo (CornerRadius,
                                            Stroke, Padding, ListLayout, ...).
      3. Si ninguna funciona             → warn.

    Esto arregla el bug de Padding sobre UIListLayout/UIGridLayout, donde
    el atajo se comía la asignación y el layout nunca recibía el valor.
]]

local Theme = Theme
local Utils = Utils
local specialKeys = SpecialKeys

local theme = Theme.palette
local merge = Utils.merge

local Components = {}

function Components.create(class, props, parent)
    local obj = Instance.new(class)
    props = props or {}

    for key, value in pairs(props) do
        -- 1) ¿Es propiedad real y escribible? Se asigna directo.
        local ok = pcall(function()
            obj[key] = value
        end)

        if not ok then
            -- 2) ¿Hay atajo declarativo para esta key?
            if specialKeys[key] then
                local ok2, err = pcall(specialKeys[key], obj, value)
                if not ok2 then
                    warn(string.format(
                        "[RevUI] special key '%s' on %s failed: %s",
                        key, class, tostring(err)
                    ))
                end
            else
                warn(string.format("[RevUI] Failed to set '%s' on %s", key, class))
            end
        end
    end

    if parent then
        obj.Parent = parent
    end

    return obj
end

function Components.frame(props, parent)
    return Components.create("Frame", merge({
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = theme.surface,
        BorderSizePixel = 0,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

function Components.button(props, parent)
    return Components.create("TextButton", merge({
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme.primary,
        Text = "",
        TextColor3 = theme.text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 14,
        BorderSizePixel = 0,
        AutoButtonColor = true,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

function Components.label(props, parent)
    return Components.create("TextLabel", merge({
        Size = UDim2.new(1, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = theme.text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        BorderSizePixel = 0,
    }, props), parent)
end

function Components.textBox(props, parent)
    return Components.create("TextBox", merge({
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = theme.surface2,
        Text = "",
        TextColor3 = theme.text,
        PlaceholderColor3 = theme.textMuted,
        Font = Enum.Font.Gotham,
        TextSize = 14,
        ClearTextOnFocus = false,
        BorderSizePixel = 0,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

function Components.imageLabel(props, parent)
    return Components.create("ImageLabel", merge({
        Size = UDim2.new(0, 40, 0, 40),
        BackgroundTransparency = 1,
        Image = "",
        BorderSizePixel = 0,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

function Components.imageButton(props, parent)
    return Components.create("ImageButton", merge({
        Size = UDim2.new(0, 40, 0, 40),
