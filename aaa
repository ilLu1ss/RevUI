local Theme = (function()
--[[
    Theme.lua — paleta + sistema de temas con repintado en vivo.
    Theme.set() MUTA la tabla palette in place: todos los módulos que
    guardaron una referencia la ven actualizada al instante.
]]

local Theme = {}

Theme.palette = {
    black = Color3.fromRGB(5, 5, 8),
    border = Color3.fromRGB(70, 50, 100),
    danger = Color3.fromRGB(220, 60, 60),
    gray = Color3.fromRGB(90, 90, 110),
    info = Color3.fromRGB(110, 90, 230),
    primary = Color3.fromRGB(139, 92, 246),
    purple = Color3.fromRGB(168, 85, 247),
    success = Color3.fromRGB(50, 210, 100),
    surface = Color3.fromRGB(15, 15, 20),
    surface2 = Color3.fromRGB(25, 25, 35),
    text = Color3.fromRGB(235, 235, 240),
    textMuted = Color3.fromRGB(120, 120, 140),
    warning = Color3.fromRGB(245, 170, 50),
    white = Color3.fromRGB(255, 255, 255),
}

Theme.presets = Themes
Theme.themes = Theme.presets


local tracked = {}
local listeners = {} -- { fn = function(palette), instance = GuiObject|nil }

--[[
    Theme.onChange(fn [, instance]) — registra un listener que se dispara
    en CADA Theme.set(). Úsalo para repintar elementos con ESTADO (tabs
    activas, toggles ON, opciones seleccionadas...) que bind() no cubre.
    Si pasas `instance`, el listener se elimina automáticamente cuando la
    instancia se destruye (cero fugas).
]]
function Theme.onChange(fn, instance)
    listeners[#listeners + 1] = { fn = fn, instance = instance }
    return fn
end

function Theme.get(key)
    return Theme.palette[key]
end

-- pinta y registra una instancia para que SetTheme la repinte en vivo
function Theme.bind(instance, prop, key)
    instance[prop] = Theme.palette[key]
    tracked[#tracked + 1] = { instance = instance, prop = prop, key = key }
end

local function resolveTheme(input)
    if type(input) == "string" then
        return Theme.presets[input] or Theme.themes[input] or Theme.Themes[input]
    end
    if type(input) == "table" then
        return input
    end
    return nil
end

function Theme.set(overrides)
    local palette = resolveTheme(overrides)
    if type(palette) ~= "table" then
        return false
    end

    for key, value in pairs(palette) do
        if Theme.palette[key] ~= nil then
            Theme.palette[key] = value
        end
    end

    for i = #tracked, 1, -1 do
        local entry = tracked[i]
        if entry.instance.Parent then
            entry.instance[entry.prop] = Theme.palette[entry.key]
        else
            table.remove(tracked, i)
        end
    end

    -- listeners con estado; se auto-purgan si su instancia murió
    for i = #listeners, 1, -1 do
        local entry = listeners[i]
        if entry.instance and not entry.instance.Parent then
            table.remove(listeners, i)
        else
            pcall(entry.fn, Theme.palette)
        end
    end

    return true
end

Theme.use = Theme.set
Theme.apply = Theme.set

return Theme
end)()

