-- // utilidades anti-detección

local function randomString(length)
    length = length or math.random(12, 24)
    local chars = {}
    for i = 1, length do
        chars[i] = string.char(math.random(32, 126))
    end
    return table.concat(chars)
end

local function getSecureParent()
    if get_hidden_gui then
        return get_hidden_gui()
    elseif gethui then
        return gethui()
    end
    if syn and syn.protect_gui then
        local protected = Instance.new("ScreenGui")
        protected.Name = randomString()
        syn.protect_gui(protected)
        protected.Parent = CoreGui
        return protected
    end
    return CoreGui
end

-- // núcleo: constructor declarativo

local specialKeys = {
    CornerRadius = function(obj, value)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = value
        corner.Parent = obj
    end,
    Stroke = function(obj, value)
        local stroke = Instance.new("UIStroke")
        if type(value) == "table" then
            stroke.Color = value.Color or Color3.new(0, 0, 0)
            stroke.Thickness = value.Thickness or 1
            stroke.Transparency = value.Transparency or 0
            stroke.ApplyStrokeMode = value.ApplyStrokeMode or Enum.ApplyStrokeMode.Border
        else
            stroke.Thickness = value
        end
        stroke.Parent = obj
    end,
    Padding = function(obj, value)
        local pad = Instance.new("UIPadding")
        if type(value) == "table" then
            pad.PaddingTop = value.Top or UDim.new(0, 0)
            pad.PaddingBottom = value.Bottom or UDim.new(0, 0)
            pad.PaddingLeft = value.Left or UDim.new(0, 0)
            pad.PaddingRight = value.Right or UDim.new(0, 0)
        else
            pad.PaddingTop = UDim.new(0, value)
            pad.PaddingBottom = UDim.new(0, value)
            pad.PaddingLeft = UDim.new(0, value)
            pad.PaddingRight = UDim.new(0, value)
        end
        pad.Parent = obj
    end,
    ListLayout = function(obj, value)
        local layout = Instance.new("UIListLayout")
        layout.Padding = value.Padding or UDim.new(0, 0)
        layout.FillDirection = value.FillDirection or Enum.FillDirection.Vertical
        layout.HorizontalAlignment = value.HorizontalAlignment or Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = value.VerticalAlignment or Enum.VerticalAlignment.Top
        layout.SortOrder = value.SortOrder or Enum.SortOrder.LayoutOrder
        layout.Parent = obj
        return layout
    end,
    GridLayout = function(obj, value)
        local layout = Instance.new("UIGridLayout")
        layout.CellSize = value.CellSize or UDim2.new(0, 100, 0, 100)
        layout.CellPadding = value.CellPadding or UDim.new(0, 0)
        layout.FillDirection = value.FillDirection or Enum.FillDirection.Horizontal
        layout.HorizontalAlignment = value.HorizontalAlignment or Enum.HorizontalAlignment.Left
        layout.VerticalAlignment = value.VerticalAlignment or Enum.VerticalAlignment.Top
        layout.SortOrder = value.SortOrder or Enum.SortOrder.LayoutOrder
        layout.Parent = obj
        return layout
    end,
    AspectRatio = function(obj, value)
        local c = Instance.new("UIAspectRatioConstraint")
        if type(value) == "table" then
            c.AspectRatio = value.AspectRatio or 1
            c.AspectType = value.AspectType or Enum.AspectType.FitWithinMaxSize
            c.DominantAxis = value.DominantAxis or Enum.DominantAxis.Width
        else
            c.AspectRatio = value
        end
        c.Parent = obj
    end,
    SizeConstraint = function(obj, value)
        local c = Instance.new("UISizeConstraint")
        c.MinSize = value.MinSize or Vector2.new(0, 0)
        c.MaxSize = value.MaxSize or Vector2.new(math.huge, math.huge)
        c.Parent = obj
    end,
    TextConstraint = function(obj, value)
        local c = Instance.new("UITextSizeConstraint")
        c.MinTextSize = value.MinTextSize or 1
        c.MaxTextSize = value.MaxTextSize or 100
        c.Parent = obj
    end,
    Gradient = function(obj, value)
        local g = Instance.new("UIGradient")
        g.Color = value.Color or ColorSequence.new(Color3.new(1, 1, 1))
        g.Rotation = value.Rotation or 0
        g.Offset = value.Offset or Vector2.new(0, 0)
        if value.Transparency then g.Transparency = value.Transparency end
        g.Parent = obj
    end,
    Events = function(obj, value)
        for eventName, callback in pairs(value) do
            local event = obj[eventName]
            if event and typeof(event) == "RBXScriptSignal" then
                event:Connect(callback)
            end
        end
    end,
    Children = function(obj, value)
        for _, child in ipairs(value) do
            if typeof(child) == "Instance" then
                child.Parent = obj
            end
        end
    end,
}

function RevUI.create(class, props, parent)
    local obj = Instance.new(class)
    props = props or {}
    for key, value in pairs(props) do
        if specialKeys[key] then
            specialKeys[key](obj, value)
        else
            local success, err = pcall(function()
                obj[key] = value
            end)
            if not success then
                warn(string.format("[RevUI] Failed to set '%s' on %s: %s", key, class, err))
            end
        end
    end
    if parent then
        obj.Parent = parent
    end
    return obj
end

-- // componentes con defaults

local function merge(defaults, props)
    props = props or {}
    for k, v in pairs(props) do
        if k == "BgColor" then
            defaults["BackgroundColor3"] = v
        else
            defaults[k] = v
        end
    end
    return defaults
end

function RevUI.frame(props, parent)
    return RevUI.create("Frame", merge({
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = colors.surface,
        BorderSizePixel = 0,
        CornerRadius = UDim.new(0, 8),
    }, props), parent)
end

