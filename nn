function Notifications.show(message, notifType)
    notifType = notifType or "info"
    local notif = RevUI.frame({
        Size = UDim2.new(0, 270, 0, 70),
        BackgroundColor3 = notifColors[notifType] or colors.surface2,
        ZIndex = 101,
        CornerRadius = UDim.new(0, 12),
        Stroke = { Color = colors.white, Thickness = 1, Transparency = 0.88 },
    }, notificationHolder)

    RevUI.icon(notifIcons[notifType] or "bell", 24, {
        Position = UDim2.new(0, 14, 0.5, -10),
        ImageColor3 = colors.white,
        ZIndex = 102,
    }, notif)

    RevUI.label({
        Size = UDim2.new(1, -66, 0, 18),
        Position = UDim2.new(0, 62, 0, 15),
        Text = notifTitles[notifType] or "Notification",
        Font = Enum.Font.GothamBold,
        TextSize = 16,
        TextColor3 = colors.white,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 102,
    }, notif)

    RevUI.label({
        Size = UDim2.new(1, -66, 0, 36),
        Position = UDim2.new(0, 62, 0, 40),
        Text = tostring(message or ""),
        TextSize = 14,
        TextColor3 = colors.white,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        ZIndex = 102,
    }, notif)

    -- animación entrada/salida
    notif.Position = UDim2.new(1, 18, 0, 0)
    notif.BackgroundTransparency = 0.15

    TweenService:Create(notif,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundTransparency = 0,
        }):Play()

    task.delay(3.2, function()
        if notif and notif.Parent then
            local exitTween = TweenService:Create(notif,
                TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
                    Position = UDim2.new(1, 18, 0, 0),
                    BackgroundTransparency = 1,
                })
            exitTween:Play()
            exitTween.Completed:Connect(function()
                if notif and notif.Parent then notif:Destroy() end
            end)
        end
    end)
end

RevUI.notify = Notifications.show

-- // ventana principal

function RevUI.CreateWindow(config)
    config = config or {}
    local width = config.width or 590
    local height = config.height or 480
    local title = config.title or "RevUI"
    local version = config.version or ""

    local secureParent = getSecureParent()
    local screenGui

    if secureParent:IsA("ScreenGui") then
        screenGui = secureParent
    else
        screenGui = RevUI.create("ScreenGui", {
            Name = randomString(),
            ResetOnSpawn = false,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            DisplayOrder = 999,
        }, secureParent)
    end

    Notifications.init(screenGui)

    local window = {}
    window.gui = screenGui

    local mainFrame = RevUI.frame({
        Name = randomString(),
        Size = UDim2.new(0, width, 0, height),
        Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
        BackgroundColor3 = colors.black,
        Active = true,
        ClipsDescendants = true,
        CornerRadius = UDim.new(0, 16),
        Stroke = { Color = Color3.fromRGB(50, 50, 60), Thickness = 1 },
    }, screenGui)
    window.frame = mainFrame

    -- animación de apertura
    mainFrame.Size = UDim2.new(0, width * 0.8, 0, height * 0.8)
    mainFrame.Position = UDim2.new(0.5, -(width * 0.8) / 2, 0.5, -(height * 0.8) / 2)
    mainFrame.BackgroundTransparency = 1
    TweenService:Create(mainFrame,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, width, 0, height),
            Position = UDim2.new(0.5, -width / 2, 0.5, -height / 2),
            BackgroundTransparency = 0,
        }):Play()

    -- top bar
    local topBar = RevUI.frame({
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        CornerRadius = UDim.new(0, 0),
    }, mainFrame)

    RevUI.create("UIPadding", {
        PaddingLeft = UDim.new(0, 16),
        PaddingRight = UDim.new(0, 16),
    }, topBar)

    RevUI.label({
        Size = UDim2.new(0, 200, 1, 0),
        Text = title,
        Font = Enum.Font.GothamBold,
        TextSize = 15,
    }, topBar)

    if version ~= "" then
        RevUI.label({
            Size = UDim2.new(0, 60, 1, 0),
            Position = UDim2.new(0.5, -30, 0, 0),
            Text = version,
            TextColor3 = colors.white,
            TextXAlignment = Enum.TextXAlignment.Center,
        }, topBar)
    end

    -- botones minimize / close
    local minimizeBtn = RevUI.imageButton({
        Size = UDim2.new(0, 24, 0, 24),
        Position = UDim2.new(1, -55, 0.5, -14),
        Image = getIcon("minus"),
        ImageColor3 = colors.textMuted,
        CornerRadius = UDim.new(0, 6),
    }, topBar)

    local closeBtn = RevUI.imageButton({
        Size = UDim2.new(0, 24, 0, 24),
        Position = UDim2.new(1, -28, 0.5, -14),
        Image = getIcon("x"),
        ImageColor3 = colors.textMuted,
        CornerRadius = UDim.new(0, 6),
    }, topBar)

    minimizeBtn.MouseEnter:Connect(function() minimizeBtn.ImageColor3 = colors.text end)
    minimizeBtn.MouseLeave:Connect(function() minimizeBtn.ImageColor3 = colors.textMuted end)
    closeBtn.MouseEnter:Connect(function() closeBtn.ImageColor3 = colors.danger end)
    closeBtn.MouseLeave:Connect(function() closeBtn.ImageColor3 = colors.textMuted end)

    -- estado minimizado
    local isMinimized = false
    local contentHolder -- se llena abajo

    minimizeBtn.MouseButton1Click:Connect(function()
        isMinimized = not isMinimized
        if isMinimized then
            TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad), {
                Size = UDim2.new(0, width, 0, 44),
            }):Play()
        else
            TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingStyle.Out and nil or nil), {
                Size = UDim2.new(0, width, 0, height),
            }):Play()
        end
    end)

    closeBtn.MouseButton1Click:Connect(function()
        TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Size = UDim2.new(0, width, 0, 44),
            BackgroundTransparency = 1,
        }):Play()
        task.wait(0.25)
        if window.onClose then window.onClose() end
        screenGui:Destroy()
    end)

    -- separator
    RevUI.frame({
        Size = UDim2.new(1, -32, 0, 1),
        Position = UDim2.new(0, 16, 0, 43),
        BackgroundColor3 = Color3.fromRGB(50, 50, 60),
        CornerRadius = UDim.new(0, 0),
    }, mainFrame)

    -- dragging
    local isDragging = false
    local dragStartPos, frameStartPos

    topBar.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
            frameStartPos = Vector2.new(mainFrame.AbsolutePosition.X, mainFrame.AbsolutePosition.Y)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if isDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStartPos
            mainFrame.Position = UDim2.new(0, frameStartPos.X + delta.X, 0, frameStartPos.Y + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = false
        end
    end)

    -- área de contenido + sidebar de tabs
    local tabContainer = RevUI.frame({
        Name = "TabContainer",
        Size = UDim2.new(0, 152, 0, height - 44 - 20),
        Position = UDim2.new(0, 12, 0, 54),
        BackgroundTransparency = 1,
        CornerRadius = UDim.new(0, 0),
    }, mainFrame)

    RevUI.create("UIListLayout", {
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabContainer)

    RevUI.create("UIPadding", { PaddingRight = UDim.new(0, 8) }, tabContainer)

    contentHolder = RevUI.frame({
        Name = "ContentArea",
        Size = UDim2.new(0, width - 172 - 8, 0, height - 44 - 20),
        Position = UDim2.new(0, 172, 0, 54),
        BackgroundColor3 = colors.surface,
        CornerRadius = UDim.new(0, 12),
        Stroke = { Color = Color3.fromRGB(45, 45, 55), Thickness = 1, Transparency = 0.6 },
    }, mainFrame)

    -- sistema de tabs
    local allTabs = {}
    local activeTab = nil

    local function selectTabCore(targetPanel, targetButton, targetIcon)
        if activeTab then
            activeTab.button.BackgroundTransparency = 1
            activeTab.button.TextColor3 = colors.textMuted
            activeTab.icon.ImageColor3 = colors.textMuted
            activeTab.panel.Visible = false
        end
        targetButton.BackgroundTransparency = 0.2
        targetButton.TextColor3 = colors.text
        targetIcon.ImageColor3 = colors.text
        targetPanel.Visible = true
        for _, tab in ipairs(allTabs) do
            if tab.panel == targetPanel then
                activeTab = tab
                break
            end
        end
    end

    function window.newTab(args)
        args = args or {}
        local name = args.name or "Tab"
        local iconName = args.icon or "circle"
        local layoutOrder = args.order or #allTabs + 1

        local panel = RevUI.frame({
            Name = name .. "Panel",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            CornerRadius = UDim.new(0, 0),
            Visible = false,
        }, contentHolder)

        local button = RevUI.button({
            Name = name .. "Tab",
            Size = UDim2.new(1, 0, 0, 40),
            BackgroundColor3 = colors.surface2,
            BackgroundTransparency = 1,
            Text = "               " .. name,
            TextColor3 = colors.textMuted,
            Font = Enum.Font.GothamSemibold,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            CornerRadius = UDim.new(0, 10),
            LayoutOrder = layoutOrder,
            AutoButtonColor = false,
        }, tabContainer)

        local icon = RevUI.icon(iconName, 18, {
            Position = UDim2.new(0, 14, 0.5, -9),
            ImageColor3 = colors.textMuted,
        }, button)

        button.MouseEnter:Connect(function()
            if activeTab and activeTab.button == button then return end
            button.BackgroundTransparency = 0.5
            button.TextColor3 = colors.text
            icon.ImageColor3 = colors.text
        end)

        button.MouseLeave:Connect(function()
            if activeTab and activeTab.button == button then return end
            button.BackgroundTransparency = 1
            button.TextColor3 = colors.textMuted
            icon.ImageColor3 = colors.textMuted
        end)

        button.MouseButton1Click:Connect(function()
            selectTabCore(panel, button, icon)
        end)

        table.insert(allTabs, { name = name, panel = panel, button = button, icon = icon })

        if #allTabs == 1 then
            selectTabCore(panel, button, icon)
        end

        return panel -- el panel es donde tú construyes tu contenido
    end

    function window.destroy()
        screenGui:Destroy()
    end

    return window
end

return RevUI
